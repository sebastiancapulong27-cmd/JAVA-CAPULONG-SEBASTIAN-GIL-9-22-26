import java.util.Scanner; //(Syntax for calling the 
//Input function on the variable in the module Scanner)

public class Main{
  public static void main(String[] args){
    System.out.println("Hello, World");
    int age = 20;
    double price = 30.20;
    float weight = 51.6f;
    char grade = 'A';
    boolean isStudent = true;
    String name = "Alice";
    
    System.out.println("Name: "+ name);
    System.out.println("Age: "+ age);
    System.out.println("Price: "+ price);
    System.out.println("Weight: "+ weight);
    System.out.println("Grade: "+ grade);
    System.out.println("Is Student?: "+ isStudent);




    Scanner scanner = new Scanner(System.in);
    //Reading One word (stops at whitespace)
    System.out.print("\nEnter your city: ");
    String userCity = scanner.next(); // reads one Word 
    System.out.println("You live in: " +userCity);

    // reading the fullline (including spaces)
    scanner.nextLine(); // clears leftover mewline from previous next()
    System.out.print("Enter a sentence about your self: ");
    String fullSentence = scanner.nextLine(); // reads the entire line or paragraph
    System.out.println("You said: "+fullSentence);
    

    int a =10, b = 3;
    System.out.println("\na + b = "+(a+b));
    System.out.println("a - b = "+(a-b));
    System.out.println("a * b = "+(a*b));
    System.out.println("a / b = "+(a/b));
    System.out.println("a % b = "+(a%b));

    boolean p = true, q = false;
    System.out.println("\np && q: "+(p&&q));
    System.out.println("p || q: "+(p||q));
    System.out.println("!p: "+(!p));
    System.out.println("!q: "+(!q));

    int score = 50; 
    score += 10;
    System.out.println("\nscore after += 10: "+score);
    score *= 2;
    System.out.println("score after *= 2: "+score);

    int counter = 5;
    System.out.println("\ncounter++ (post): "+counter++);
    System.out.println("counter now: "+counter++);
    System.out.println("++counter (pre): "+ +counter); 


    System.out.println("\nEnter your exam score: ");
    int Examscore = scanner.nextInt();
    if (Examscore >= 90){
      System.out.println("Grade: A");
    } else if (Examscore>=80){
      System.out.println("Grade: B");
    } else if (Examscore>=70){
      System.out.println("Grade: C");
    } else{
      System.out.println("Grade: F");
    }
    scanner.close();
  }
}
